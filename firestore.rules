rules_version = '2';

// Book Mart — Firestore security rules
// Paste this whole file into Firebase Console → Firestore Database → Rules → Publish.
// Each build phase adds rules for its new collections.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }

    // Developer admin (locked). Must match ADMIN_EMAIL in src/lib/firebase.js
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'saadmalikok@gmail.com';
    }

    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function profile() { return get(userPath()).data; }

    function isActive() {
      return signedIn() && exists(userPath()) && profile().active == true;
    }

    // Does the signed-in user's role have permission p?
    function can(p) {
      return isAdmin() || (
        isActive() &&
        get(/databases/$(database)/documents/roles/$(profile().roleId)).data.permissions.get(p, false) == true
      );
    }

    // ---------- users ----------
    match /users/{uid} {
      // everyone active can see staff names (for reports); a blocked user can still read their own record
      allow read: if isAdmin() || isActive() || (signedIn() && request.auth.uid == uid);

      // Admin can do anything. A "manage_users" role can add/edit staff, but never
      // touch the admin, never make someone admin, and never edit themselves.
      allow create, update: if isAdmin() || (
        can('manage_users') &&
        uid != request.auth.uid &&
        request.resource.data.roleId != 'admin' &&
        (resource == null || resource.data.roleId != 'admin')
      );
      allow delete: if isAdmin();
    }

    // ---------- roles (Admin only) ----------
    match /roles/{roleId} {
      allow read: if isAdmin() || isActive();
      allow write: if isAdmin();
    }

    // ---------- shop settings ----------
    match /settings/{docId} {
      allow read: if isAdmin() || isActive();
      allow write: if can('shop_settings');
    }

    // ---------- internal ----------
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // ---------- catalog (Phase 2) ----------
    function canReadShop() { return isAdmin() || isActive(); }

    match /categories/{id} {
      allow read: if canReadShop();
      allow write: if can('manage_items');
    }
    match /items/{id} {
      allow read: if canReadShop();
      allow write: if can('manage_items');
    }
    match /variants/{id} {
      allow read: if canReadShop();
      allow create, delete: if can('manage_items');
      // buying and adjusting may only change the stock number
      allow update: if can('manage_items')
        || ((can('buy') || can('stock_adjust') || can('sell') || can('sale_returns'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }
    // one doc per barcode keeps barcodes unique
    match /barcodes/{code} {
      allow read: if canReadShop();
      allow create, delete: if can('manage_items');
    }
    // cost prices are hidden from roles without "See cost price"
    // sellers need to read the average cost so each sale stores its cost for profit reports
    // (the app only SHOWS costs to roles with "See cost price")
    match /itemCosts/{id} {
      allow read: if can('view_cost_price') || can('buy') || can('sell');
      allow write: if (can('manage_items') && can('view_cost_price')) || can('buy');
    }
    // stock history: Phase 2 writes opening stock only
    match /stockMoves/{id} {
      allow read: if can('view_items');
      allow create: if request.resource.data.by == request.auth.uid && (
           (request.resource.data.type == 'opening'  && can('manage_items'))
        || (request.resource.data.type == 'purchase' && can('buy'))
        || (request.resource.data.type == 'adjust'   && can('stock_adjust'))
        || (request.resource.data.type == 'sale'     && can('sell'))
        || (request.resource.data.type == 'return'   && can('sale_returns'))
      );
    }
    match /counters/barcode {
      allow read, write: if can('manage_items');
    }

    // ---------- buying & suppliers (Phase 3) ----------
    function supplierAccess() { return can('manage_suppliers') || can('buy') || can('pay_suppliers'); }

    match /suppliers/{id} {
      allow read: if supplierAccess();
      allow create: if can('manage_suppliers');
      // details: manage_suppliers. Balance only: buying or paying.
      allow update: if can('manage_suppliers')
        || ((can('buy') || can('pay_suppliers'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt']));
    }
    match /supplierLedger/{id} {
      allow read: if supplierAccess();
      allow create: if request.resource.data.by == request.auth.uid && (
           (request.resource.data.type == 'purchase' && can('buy'))
        || (request.resource.data.type == 'payment' && (can('pay_suppliers') || can('buy')))
      );
    }
    match /purchases/{id} {
      allow read: if can('buy') || can('manage_suppliers') || can('view_reports');
      allow create: if can('buy') && request.resource.data.by == request.auth.uid;
    }

    // ---------- selling (Phase 4) ----------
    match /sales/{id} {
      allow read: if can('view_sales') || can('view_reports') || can('daily_closing') || can('sale_returns')
                  || (signedIn() && resource.data.by == request.auth.uid);
      allow create: if can('sell')
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.discount == 0 || can('sell_discount'))
        && (request.resource.data.due == 0 || can('sell_credit'));
      // returns may only record what came back
      allow update: if can('sale_returns')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returned', 'returnedTotal', 'updatedAt']);
    }
    match /returns/{id} {
      allow read: if can('sale_returns') || can('view_sales') || can('view_reports') || can('daily_closing');
      allow create: if can('sale_returns') && request.resource.data.by == request.auth.uid;
    }
    // running daily totals (each sale adds to them)
    match /dailyStats/{day} {
      allow read: if can('daily_closing') || can('view_reports') || can('view_profit_loss') || can('view_sales');
      allow create, update: if can('sell') || can('sale_returns') || can('expenses') || can('cash_out')
                            || can('receive_payments') || can('investment') || can('buy') || can('pay_suppliers');
    }

    // ---------- customers & udhaar ----------
    function customerAccess() { return can('sell_credit') || can('manage_customers') || can('receive_payments'); }

    match /customers/{id} {
      allow read: if customerAccess();
      allow create: if can('sell_credit') || can('manage_customers');
      allow update: if can('manage_customers')
        || ((can('sell_credit') || can('receive_payments') || can('sale_returns'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt']));
    }
    match /customerLedger/{id} {
      allow read: if customerAccess();
      allow create: if request.resource.data.by == request.auth.uid && (
           (request.resource.data.type == 'sale'    && can('sell_credit'))
        || (request.resource.data.type == 'payment' && can('receive_payments'))
        || (request.resource.data.type == 'return'  && can('sale_returns'))
      );
    }

    // ---------- money (Phase 6) ----------
    // A wrong entry can be undone by the person who made it within a day, or by the Admin any time.
    function undoable() {
      return isAdmin() || (resource.data.by == request.auth.uid && request.time < resource.data.at + duration.value(1, 'd'));
    }
    function newEntry() {
      return request.resource.data.by == request.auth.uid && request.resource.data.amount > 0;
    }

    match /expenses/{id} {
      allow read: if can('expenses') || can('daily_closing') || can('view_profit_loss') || can('view_reports');
      allow create: if can('expenses') && newEntry();
      allow delete: if can('expenses') && undoable();
    }
    // owner cash out: who took it, when, how much
    match /cashOuts/{id} {
      allow read: if can('cash_out') || can('view_cash_out_summary') || can('daily_closing');
      allow create: if can('cash_out') && newEntry();
      allow delete: if can('cash_out') && undoable();
    }
    match /investments/{id} {
      allow read: if can('investment') || can('view_profit_loss');
      allow create: if can('investment') && newEntry();
      allow delete: if can('investment') && undoable();
    }
    // one closing per day; re-counting updates it
    match /closings/{day} {
      allow read: if can('daily_closing') || can('view_reports');
      allow create, update: if can('daily_closing') && request.resource.data.by == request.auth.uid;
    }

    // Everything else is closed until its phase adds rules.
  }
}
